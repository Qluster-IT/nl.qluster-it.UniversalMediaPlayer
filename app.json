{
  "id": "nl.qluster-it.UniversalMediaPlayer",
  "version": "1.1.1",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#1A3E59",
  "name": {
    "en": "Universal Media Player",
    "nl": "Universele Media Speler"
  },
  "description": {
    "en": "Turn any device in a Media Player with remote storage",
    "nl": "Verander elk apparaat in een Media Speler met externe opslag"
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "source": "https://bitbucket.org/QlusterIT/nl.qluster-it.universalmediaplayer/",
  "bugs": {
    "url": "https://bitbucket.org/QlusterIT/nl.qluster-it.universalmediaplayer/issues"
  },
  "homeyCommunityTopicId": 43450,
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "contributors": {
    "developers": [
      {
        "name": "Johan Bendz",
        "email": "johan_bendz@hotmail.com"
      }
    ]
  },
  "flow": {
    "triggers": [
      {
        "id": "url_trigger",
        "title": {
          "en": "Url trigger"
        },
        "titleFormatted": {
          "en": "Url changed"
        },
        "tokens": [
          {
            "name": "url",
            "type": "string",
            "title": {
              "en": "Url"
            }
          },
          {
            "name": "duration",
            "type": "number",
            "title": {
              "en": "Duration"
            }
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          }
        ]
      },
      {
        "id": "stopped_trigger",
        "title": {
          "en": "Stopped"
        },
        "titleFormatted": {
          "en": "Stopped"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          }
        ]
      },
      {
        "id": "finished_trigger",
        "title": {
          "en": "Finished"
        },
        "titleFormatted": {
          "en": "Finished: Duration done"
        },
        "tokens": [
          {
            "type": "boolean",
            "name": "hasMessage",
            "title": {
              "en": "Has message",
              "nl": "Heeft een bericht"
            }
          },
          {
            "type": "string",
            "name": "message",
            "title": {
              "en": "Message",
              "nl": "Bericht"
            }
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "condition_upnpplayer_play_file",
        "title": {
          "en": "Play a UPnP file",
          "nl": "Speel een UPnP bestand"
        },
        "titleFormatted": {
          "en": "Playing [[file]] and finish",
          "nl": "Speel [[file]] en voltooi"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          },
          {
            "type": "autocomplete",
            "name": "file",
            "placeholder": {
              "en": "File",
              "nl": "Bestand"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "upnpplayer_get_file",
        "title": {
          "en": "Get a UPnP file"
        },
        "titleFormatted": {
          "en": "Start playing file [[file]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          },
          {
            "type": "autocomplete",
            "name": "file",
            "placeholder": {
              "en": "File",
              "nl": "File"
            }
          }
        ]
      },
      {
        "id": "upnpplayer_get_file_message",
        "title": {
          "en": "Get a UPnP file "
        },
        "titleFormatted": {
          "en": "Start playing file [[file]] and finish with [[message]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          },
          {
            "type": "autocomplete",
            "name": "file",
            "placeholder": {
              "en": "File",
              "nl": "File"
            }
          },
          {
            "type": "text",
            "name": "message",
            "placeholder": {
              "en": "Message on finish",
              "nl": "Melding na afspelen"
            }
          }
        ]
      },
      {
        "id": "upnpplayer_get_folder",
        "title": {
          "en": "Start a UPnP folder"
        },
        "titleFormatted": {
          "en": "Start playing folder [[folder]] mode [[mode]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          },
          {
            "type": "autocomplete",
            "name": "folder",
            "placeholder": {
              "en": "Folder",
              "nl": "Map"
            }
          },
          {
            "type": "dropdown",
            "name": "mode",
            "placeholder": {
              "en": "Mode",
              "nl": "Mode"
            },
            "values": [
              {
                "id": "single",
                "name": "Single",
                "label": {
                  "en": "Play the first item in the folder"
                }
              },
              {
                "id": "randomsingle",
                "name": "Random Single",
                "label": {
                  "en": "Play one random item in the folder"
                }
              },
              {
                "id": "normal",
                "name": "Normal",
                "label": {
                  "en": "Play all items in the folder (one time)"
                }
              },
              {
                "id": "repeat",
                "name": "Repeat",
                "label": {
                  "en": "Play all items in the folder (repeat)"
                }
              },
              {
                "id": "randomnormal",
                "name": "Random",
                "label": {
                  "en": "Play all items in the folder randomly (one time)"
                }
              },
              {
                "id": "randomrepeat",
                "name": "RandomRepeat",
                "label": {
                  "en": "Play all items in the folder randomly (repeat)"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "upnpplayer",
      "name": {
        "en": "UPnP Player"
      },
      "class": "speaker",
      "capabilities": [
        "speaker_playing",
        "speaker_next",
        "speaker_prev",
        "speaker_shuffle",
        "speaker_repeat",
        "speaker_artist",
        "speaker_album",
        "speaker_track",
        "speaker_duration"
      ],
      "images": {
        "large": "/drivers/upnpplayer/assets/images/large.png",
        "small": "/drivers/upnpplayer/assets/images/small.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_my_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}:\\d{1,5}\\b$",
          "label": {
            "en": "IP Address"
          },
          "value": "",
          "hint": {
            "en": "Specifies the IP address and port of the UPnP Server on your network."
          }
        },
        {
          "id": "delay",
          "type": "number",
          "label": {
            "en": "Delay between playing in ms"
          },
          "value": 1000,
          "hint": {
            "en": "Extra waiting time before playing the next file"
          }
        }
      ]
    }
  ]
}