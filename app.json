{
  "id": "nl.qluster-it.UPnPPlayer",
  "version": "0.5.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#E8A713",
  "name": {
    "en": "UPnP Player",
    "nl": "UPnP Player"
  },
  "description": {
    "en": "UPnP Player to find the URL of files through browsing",
    "nl": "UPnP Player om de URL van bestanden te vinden via bladeren"
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "source": "https://bitbucket.org/QlusterIT/nl.qluster-it.upnpplayer/",
  "bugs": {
    "url": "https://bitbucket.org/QlusterIT/nl.qluster-it.upnpplayer/issues"
  },
  "homeyCommunityTopicId": 43450,
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "flow": {
    "triggers": [      
      
      {
        "id": "url_trigger",        
        "title": {
          "en": "Url trigger"
        },
        "titleFormatted": {
          "en": "Url changed"
        },
        "tokens": [
          {
            "name": "url",
            "type": "string",
            "title": {
              "en": "Url"
            }
          },
          {
            "name": "duration",
            "type": "number",
            "title": {
              "en": "Duration"
            }
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          }        
        ]        
      },
      {
        "id": "stopped_trigger",        
        "title": {
          "en": "Stopped"
        },
        "titleFormatted": {
          "en": "Stopped"
        },          
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          }        
        ]        
      },
      {
        "id": "finished_trigger",        
        "title": {
          "en": "Finished"
        },
        "titleFormatted": {
          "en": "Finished: Duration done"
        },
        "tokens": [
          {
            "type": "boolean",
            "name": "hasMessage",
            "title":{
              "en":"Has message"	,
              "nl":"Heeft een bericht"
            }
          },
          {
            "type": "string",
            "name": "message",
            "title":{
              "en":"Message"	,
              "nl":"Bericht"
            }
          }        
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          }        
        ]        
      }
    ],
    "actions": [
      {
        "id": "upnpplayer_get_file",        
        "title": {
          "en": "Get a UPnP file"
        },
        "titleFormatted": {
          "en": "Start playing file [[file]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          },
          {
            "type": "autocomplete",
            "name": "file",
            "placeholder": {
              "en": "File",
              "nl": "File"
            }
          }
        ]        
      },{
        "id": "upnpplayer_get_file_message",        
        "title": {
          "en": "Get a UPnP file "
        },
        "titleFormatted": {
          "en": "Start playing file [[file]] and finish with [[message]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          },
          {
            "type": "autocomplete",
            "name": "file",
            "placeholder": {
              "en": "File",
              "nl": "File"
            }
          },
          {
            "type": "text",
            "name": "message",
            "placeholder": {
              "en": "Message on finish",
              "nl": "Melding na afspelen"
            }
          }
        ]        
      },
      {
        "id": "upnpplayer_get_folder",        
        "title": {
          "en": "Start a UPnP folder"
        },
        "titleFormatted": {
          "en": "Start playing folder [[folder]] mode [[mode]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          },
          {
            "type": "autocomplete",
            "name": "folder",
            "placeholder": {
              "en": "Folder",
              "nl": "Folder"
            }
          },
          
          {
            "type": "dropdown",
            "name": "mode",
            "placeholder": {
              "en": "Mode",
              "nl": "Mode"
            },
            "values": [
              {
                "id": "single",
                "name": "Single",
                "label": {
                  "en": "Play the first item in the folder"
                }
              },
              {
                "id": "randomsingle",
                "name": "Random Single",
                "label": {
                  "en": "Play one random item in the folder"
                }
              },
              {
                "id": "normal",
                "name": "Normal",
                "label": {
                  "en": "Play all items in the folder (one time)"
                }
              },
              {
                "id": "repeat",
                "name": "Repeat",
                "label": {
                  "en": "Play all items in the folder (repeat)"
                }
              },
              {
                "id": "random",
                "name": "Random",
                "label": {
                  "en": "Play all items in the folder randomly (one time)"
                }
              },
              {
                "id": "randomrepeat",
                "name": "RandomRepeat",
                "label": {
                  "en": "Play all items in the folder randomly (repeat)"
                }
              }
            ]
          }
        ]        
      }
    ]
  },
  "drivers": [    
    {
      "id": "upnpplayer",
      "name": {
        "en": "UPnP Player"
      },
      "class": "speaker",
      "capabilities": [
        "speaker_playing", 
        "speaker_next", 
        "speaker_prev", 
        "speaker_shuffle", 
        "speaker_repeat", 
        "speaker_artist", 
        "speaker_album", 
        "speaker_track", 
        "speaker_duration"
      ],
      "images": {
        "large": "/drivers/watch/assets/images/large.png",
        "small": "/drivers/watch/assets/images/small.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_my_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}:\\d{1,5}\\b$",
          "label": {
            "en": "IP Address"
          },
          "value": "",
          "hint": {
            "en": "Specifies the IP address and port of the UPnP Server on your network."
          }
        },
        {
          "id": "delay",
          "type": "number",
          "label": {
            "en": "Delay between playing in ms"
          },
          "value": 1000,
          "hint": {
            "en": "Extra waiting time before playing the next file"
          }
        }
      ]
    }
  ]
}