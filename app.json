{
  "id": "nl.qluster-it.UPnPServer",
  "version": "0.5.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#E8A713",
  "name": {
    "en": "UPnP Server",
    "nl": "UPnP Server"
  },
  "description": {
    "en": "Use an UPnP Server to find the URL of files through browsing",
    "nl": "Gebruik een UPnP Server om de URL van bestanden te vinden via bladeren"
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "flow": {
    "triggers": [      
      {
        "id": "trigger_flow",        
        "title": {
          "en": "Triggers get file url"
        },
        "titleFormatted": {
          "en": "Will be triggered by [[trigger]]"
        },
        "tokens": [
          {
            "name": "url",
            "type": "string",
            "title": {
              "en": "Url"
            }
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpserverdriver"
          },{
            "type": "text",
            "name": "trigger",
            "placeholder": {
              "en": "Triggername",
              "nl": "Triggername"
            }
          }          
        ]        
      }
    ],
    "actions": [
      {
        "id": "upnpserver_get_file",        
        "title": {
          "en": "Get a UPnP file url"
        },
        "titleFormatted": {
          "en": "Get the url from UPnP file [[file]] and activate trigger [[trigger]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpserverdriver"
          },
          {
            "type": "autocomplete",
            "name": "file",
            "placeholder": {
              "en": "File",
              "nl": "File"
            }
          },
          {
            "type": "text",
            "name": "trigger",
            "placeholder": {
              "en": "Trigger",
              "nl": "Trigger"
            }
          }
        ]        
      }
    ]
  },
  "drivers": [    
    {
      "id": "upnpserverdriver",
      "name": {
        "en": "UPnP Server"
      },
      "class": "other",
      "capabilities": [],
      "images": {
        "large": "/drivers/watch/assets/images/large.png",
        "small": "/drivers/watch/assets/images/small.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          }
        },
        {
          "id": "add_my_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$",
          "label": {
            "en": "IP Address"
          },
          "value": "",
          "hint": {
            "en": "Specifies the IP address of the UPnP on your network."
          }
        }
      ]
    }
  ]
}