{
  "id": "nl.qluster-it.UPnPPlayer",
  "version": "0.5.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#E8A713",
  "name": {
    "en": "UPnP Player",
    "nl": "UPnP Player"
  },
  "description": {
    "en": "Use an UPnP Player to find the URL of files through browsing",
    "nl": "Gebruik een UPnP Player om de URL van bestanden te vinden via bladeren"
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "flow": {
    "triggers": [      
      {
        "id": "playlist_trigger",        
        "title": {
          "en": "Playlist trigger"
        },
        "titleFormatted": {
          "en": "Trigger for [[playlist]]"
        },
        "tokens": [
          {
            "name": "url",
            "type": "string",
            "title": {
              "en": "Url"
            }
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          }        
        ]        
      }
    ],
    "actions": [
      {
        "id": "upnpplayer_get_file",        
        "title": {
          "en": "Get a UPnP file url"
        },
        "titleFormatted": {
          "en": "Get [[file]] and start playlist [[playlist]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          },
          {
            "type": "autocomplete",
            "name": "file",
            "placeholder": {
              "en": "File",
              "nl": "File"
            }
          },
          {
            "type": "autocomplete",
            "name": "playlist",
            "placeholder": {
              "en": "Playlist",
              "nl": "Playlist"
            }
          }
        ]        
      },
      {
        "id": "upnpplayer_get_folder",        
        "title": {
          "en": "Start a UPnP folder"
        },
        "titleFormatted": {
          "en": "Get [[folder]] and start playlist [[playlist]] mode [[mode]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=upnpplayer"
          },
          {
            "type": "autocomplete",
            "name": "folder",
            "placeholder": {
              "en": "Folder",
              "nl": "Folder"
            }
          },
          {
            "type": "autocomplete",
            "name": "playlist",
            "placeholder": {
              "en": "Playlist",
              "nl": "Playlist"
            }
          },
          {
            "type": "dropdown",
            "name": "mode",
            "placeholder": {
              "en": "Mode",
              "nl": "Mode"
            },
            "values": [              
              {
                "id": "normal",
                "name": "Normal",
                "label": {
                  "en": "Play all items in the folder"
                }
              },
              {
                "id": "repeat",
                "name": "Repeat",
                "label": {
                  "en": "Play all items in the folder and starts again from the beginning"
                }
              },
              {
                "id": "random",
                "name": "Random",
                "label": {
                  "en": "Play all items in the folder one time randomly"
                }
              },
              {
                "id": "randomsingle",
                "name": "Random Single",
                "label": {
                  "en": "Play one random item in the folder"
                }
              },
              {
                "id": "randomrepeat",
                "name": "RandomRepeat",
                "label": {
                  "en": "Play all items in the folder randomly and keeps playing till stopped"
                }
              }
            ]
          }
        ]        
      }
    ]
  },
  "drivers": [    
    {
      "id": "upnpplayer",
      "name": {
        "en": "UPnP Player"
      },
      "class": "speaker",
      "capabilities": [
        "speaker_playing", 
        "speaker_next", 
        "speaker_prev", 
        "speaker_shuffle", 
        "speaker_repeat", 
        "speaker_artist", 
        "speaker_album", 
        "speaker_track", 
        "speaker_duration"

      ],
      "images": {
        "large": "/drivers/watch/assets/images/large.png",
        "small": "/drivers/watch/assets/images/small.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_my_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$",
          "label": {
            "en": "IP Address"
          },
          "value": "",
          "hint": {
            "en": "Specifies the IP address of the UPnP on your network."
          }
        }
      ]
    }
  ]
}